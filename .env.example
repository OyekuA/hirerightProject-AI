# ── Required ──────────────────────────────────────────────────────────
API_KEY=your-api-key-here
LLM_API_KEY=sk-...
QDRANT_HOST=qdrant
QDRANT_PORT=6333
INGEST_STATUS_STORE_PATH=/data/ingest_status
CALLBACK_HMAC_SECRET=your-hmac-secret-here
GENERATION_BREAKER_COOLDOWN_SECONDS=60
EMBEDDING_BREAKER_COOLDOWN_SECONDS=60

# ── LLM ──────────────────────────────────────────────────────────────
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_GENERATION_TIMEOUT_SECONDS=30
LLM_EMBEDDING_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_BASE_SECONDS=1.0
LLM_JSON_MODE_ENABLED=true
LLM_GENERATION_MAX_TOKENS=4096
LLM_SEED=42

# ── Prompt ──────────────────────────────────────────────────────────
MAX_PROMPT_CHARS=50000

# ── Ingestion ────────────────────────────────────────────────────────
MAX_INGEST_FILE_MB=10
INGEST_FETCH_TIMEOUT_SECONDS=20

# ── Callback ────────────────────────────────────────────────────────
CALLBACK_SIGNATURE_TTL_SECONDS=300
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_RETRY_BASE_SECONDS=2
CALLBACK_TIMEOUT_SECONDS=10

# ── Ingest Queue ────────────────────────────────────────────────────
INGEST_QUEUE_MAX_RETRIES=5
INGEST_QUEUE_BACKOFF_BASE_SECONDS=60
INGEST_QUEUE_POLL_INTERVAL_SECONDS=30

# ── Cache ───────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=86400

# ── Replica ─────────────────────────────────────────────────────────
ENFORCE_SINGLE_REPLICA=false

# ── Dead Letter ──────────────────────────────────────────────────────
DEAD_LETTER_POLL_INTERVAL_SECONDS=300

# ── Observability ───────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=

# ── Recall.ai / Interview Assist ────────────────────────────────────
RECALL_AI_API_KEY=your-recall-ai-api-key-here
RECALL_AI_REGION=us-east-1
RECALL_AI_WEBHOOK_SECRET=your-recall-webhook-secret-here
INTERVIEW_SESSION_STORE_PATH=/data/interview_sessions

# ── Docs ────────────────────────────────────────────────────────────
ENABLE_DOCS=false
DOCS_USERNAME=
DOCS_PASSWORD=
