# Shared secret for X-API-Key authentication between PHP and FastAPI
API_KEY=change-me-in-production

# Google AI API key for Gemini LLM and embedding calls
GEMINI_API_KEY=your-google-ai-api-key

# Qdrant vector database hostname (Docker Compose service name)
QDRANT_HOST=qdrant

# Qdrant vector database port
QDRANT_PORT=6333

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# In‑memory cache TTL in seconds (default 24 hours)
CACHE_TTL_SECONDS=86400

# Cooldown period in seconds after a generation circuit‑breaker trips
GENERATION_BREAKER_COOLDOWN_SECONDS=60

# Cooldown period in seconds after an embedding circuit‑breaker trips
EMBEDDING_BREAKER_COOLDOWN_SECONDS=60

# Timeout in seconds for Gemini generation requests
GEMINI_GENERATION_TIMEOUT_SECONDS=30

# Timeout in seconds for Gemini embedding requests
GEMINI_EMBEDDING_TIMEOUT_SECONDS=30

# Maximum retries for transient failures before recording a circuit breaker failure
GEMINI_MAX_RETRIES=2

# Base backoff seconds for retry exponential backoff
GEMINI_RETRY_BACKOFF_BASE_SECONDS=1.0

# Maximum allowed prompt characters (truncation limit)
MAX_PROMPT_CHARS=50000

# Path where ingestion status files are permanently stored (mounted named volume)
INGEST_STATUS_STORE_PATH=/data/ingest_status

# HMAC secret used to sign callback payloads
CALLBACK_HMAC_SECRET=change-me-in-production

# Time‑to‑live in seconds for callback signatures
CALLBACK_SIGNATURE_TTL_SECONDS=300

# Maximum file size (MB) allowed for document ingestion
MAX_INGEST_FILE_MB=10

# Timeout in seconds when fetching external URLs during ingestion
INGEST_FETCH_TIMEOUT_SECONDS=20

# If True, the service warns when multiple replicas are detected (lock‑file guard)
ENFORCE_SINGLE_REPLICA=False

# Maximum Attempts for callback delivery
CALLBACK_MAX_ATTEMPTS=3

# Base delay in seconds for exponential backoff of callback retries
CALLBACK_RETRY_BASE_SECONDS=2

# Log level: ERROR for production, DEBUG for local development
LOG_LEVEL=ERROR